# 复制成 .env.local 再填（.env.local 已 gitignore）。全都留空也能跑：
#   没有 Supabase 时文章、分类、留言都只存在本机 localStorage。

# ── Supabase（文章 / 分类 / 共鸣 / 登录）──────────────────────────
# 建表与 RLS 见 supabase/*.sql；记得把里面 is_gardener() 的邮箱换成你自己的。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── 静态素材 CDN（可选，不设就读 public/ 下同名目录）─────────────────
# 音频：设了就把 /audio/...flac 改写成这里的 .m4a；不设回退 public/audio（不进 git，自备）
VITE_AUDIO_BASE=
# 歌词 JSON：不设时用 ${VITE_AUDIO_BASE}/lyrics，再不设用 /lyrics
VITE_LYRICS_BASE=
# 园图卷、尺牍、花园封面资源包
VITE_YUANTU_BASE=
VITE_LIGHTS_BASE=
VITE_GARDEN_BASE=

# ── 仅本地脚本用，不会进前端 ────────────────────────────────────────
# scripts/export-posts.mjs：有它能连草稿一起导出，否则退回 anon key
SUPABASE_SERVICE_KEY=
# scripts/translate-lyrics.mjs 等：歌词翻译，模型名必须显式写
ANTHROPIC_API_KEY=
LYRICS_TRANSLATION_MODEL=
